# ─────────────────────────────────────────
# Click2GO – Environment Configuration
# Copy this file to .env and fill in values.
# Every key is OPTIONAL — the stack boots with zero configuration.
# ─────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini                              # optional, defaults to gpt-4o-mini
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here     # optional, uses fallback geocoding

# ── Image generation ──────────────────────────────────────────────────────
# Poster providers are tried in priority order; missing keys are skipped.
GEMINI_API_KEY=your_gemini_api_key_here               # primary — Gemini 2.5 Flash Image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image             # optional override
REPLICATE_API_TOKEN=your_replicate_api_token_here     # fallback — FLUX Schnell
IMAGE_PROVIDER_PRIORITY=gemini,replicate,pollinations # order to try providers
AUTO_GENERATE_POSTER=false                            # render poster as final pipeline step

# ── Database ──────────────────────────────────────────────────────────────
# Default: zero-config SQLite (seed architecture, no setup needed).
DATABASE_URL=sqlite:///./click2go.db
# Host your own Postgres instead (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://click2go:click2go@localhost:5432/click2go
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# ── External services ─────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:18060/mcp             # Xiaohongshu scraper (run ./start.sh)

# ── Internal DB MCP server ────────────────────────────────────────────────
# Route Optimizer reaches the read-only DB tools over a real MCP round-trip
# (backend.mcp.db_server) instead of in-process. Leave false for speed/offline.
DB_MCP_ENABLED=false
# DB_MCP_COMMAND=python
# DB_MCP_ARGS=-m,backend.mcp.db_server

# ── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console                                    # "json" for structured logs
SERVICE_NAME=click2go

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=*
