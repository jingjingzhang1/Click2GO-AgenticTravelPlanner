# ─────────────────────────────────────────
# Click2GO – Environment Configuration
# Copy this file to .env and fill in values.
# Every key is OPTIONAL — the stack boots with zero configuration.
# NOTE: .env is gitignored — never commit real keys.
# ─────────────────────────────────────────

# ── AI / LLM ──────────────────────────────────────────────────────────────
# Used for POI scoring / verification and the Design Agent's chat.
# Works with OpenAI directly, or any OpenAI-compatible gateway (e.g. OpenRouter).
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini                               # or e.g. "openai/gpt-4o-mini" on OpenRouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1         # set to route through OpenRouter
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here      # optional — Google Places + geocoding

# ── Database ──────────────────────────────────────────────────────────────
# Default: zero-config SQLite (seed architecture, no setup needed).
DATABASE_URL=sqlite:///./click2go.db
# Host your own Postgres instead (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://click2go:click2go@localhost:5432/click2go
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# ── Internal DB MCP server ────────────────────────────────────────────────
# Route Optimizer reaches the read-only DB tools over a real MCP round-trip
# (backend.mcp.db_server) instead of in-process. Leave false for speed/offline.
DB_MCP_ENABLED=false
# DB_MCP_COMMAND=python
# DB_MCP_ARGS=-m,backend.mcp.db_server

# ── Observability ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=console                                    # "json" for structured logs
SERVICE_NAME=click2go

# ── App ───────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
CORS_ORIGINS=*
