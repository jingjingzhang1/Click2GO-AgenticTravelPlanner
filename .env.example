# ─────────────────────────────────────────
# Click2GO – Environment Configuration
# Copy this file to .env and fill in values
# ─────────────────────────────────────────

# AI API Keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini                             # optional, defaults to gpt-4o-mini
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here   # optional, uses fallback geocoding

# Image Generation (Replicate – FLUX Schnell)
REPLICATE_API_TOKEN=your_replicate_api_token_here    # optional, falls back to Pollinations

# Database – SQLite (seed architecture, no setup needed)
DATABASE_URL=sqlite:///./click2go.db

# Xiaohongshu MCP Server (run ./start.sh first)
MCP_SERVER_URL=http://localhost:18060/mcp

# App settings
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
